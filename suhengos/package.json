{
  "name": "suheng-os",
  "productName": "素衡OS",
  "private": true,
  "version": "1.0.0",
  "description": "素衡OS（Suheng OS）— 融合中医健康管理与跨境电商的智能体桌面平台",
  "author": "Suheng OS Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "dev:ops": "vite --mode ops",
    "dev:dev": "vite --mode dev",
    "build": "vue-tsc -b && vite build",
    "build:admin": "vite build --mode admin",
    "build:ops": "vite build --mode ops",
    "build:dev": "vite build --mode dev",
    "build:all": "vite build && vite build --mode admin && vite build --mode ops && vite build --mode dev",
    "preview": "vite preview",
    "electron:dev": "vite --port 5173 & wait-on http://localhost:5173 && cross-env DEPLOY_RUN_PORT=5173 electron .",
    "electron:build": "pnpm run build:all && electron-builder",
    "electron:build:win": "pnpm run build:all && electron-builder --win --x64",
    "electron:build:mac": "pnpm run build:all && electron-builder --mac",
    "electron:build:linux": "pnpm run build:all && electron-builder --linux"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "^5.5.1",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "serve": "^14.2.6",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.suheng-os.desktop",
    "productName": "素衡OS",
    "copyright": "Copyright © 2024 Suheng OS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-admin/**/*",
      "dist-ops/**/*",
      "dist-dev/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "素衡OS-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "素衡OS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Medical"
    },
    "portable": {
      "artifactName": "素衡OS-${version}-portable.${ext}"
    }
  }
}
